# ==========================================================
# BSEDRC DEVELOPMENT ENVIRONMENT
# Copy this file to .env and set values before running the app.
# ==========================================================

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase Configuration (PHASE 2)
# Get these from your Supabase project settings
# IMPORTANT: SUPABASE_SECRET_KEY is server-only and must NEVER be exposed to frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-do-not-share

# Temporary mock admin credentials for local development only.
ADMIN_SUPER_USERNAME=admin
ADMIN_SUPER_PASSWORD=admin123
ADMIN_CONTROLLER_USERNAME=controller
ADMIN_CONTROLLER_PASSWORD=bsedrc@2026
ADMIN_OFFICER_USERNAME=officer
ADMIN_OFFICER_PASSWORD=pass123

# Optional future gateway placeholders (not used yet)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_CURRENCY=INR
CLOUDFLARE_R2_BUCKET_NAME=bsedrc-student-documents
CLOUDFLARE_R2_PUBLIC_URL=https://example.r2.dev
DATABASE_URL=sqlite://local-dev-mock.db


