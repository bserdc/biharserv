# ==========================================================
# BIHAR STATE EDUCATIONAL DEVELOPMENT AND RESEARCH COUNCIL (BSEDRC)
# ENVIRONMENT CONFIGURATION (.env)
# ==========================================================

# ----------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY CONFIGURATION
# ----------------------------------------------------------
# Credentials dashboard: https://dashboard.razorpay.com/#/app/keys
# Test Mode: rzp_test_... | Live Production: rzp_live_...
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
RAZORPAY_CURRENCY="INR"

# ----------------------------------------------------------
# 2. CLOUDFLARE R2 OBJECT STORAGE CONFIGURATION
# ----------------------------------------------------------
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# Used for storing student photos, documents, admit cards, marksheets
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
CLOUDFLARE_R2_BUCKET_NAME="bsedrc-student-documents"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-your-subdomain.r2.dev"
CLOUDFLARE_R2_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"

# ----------------------------------------------------------
# 3. RELATIONAL DATABASE (MYSQL / POSTGRESQL / CLOUD SQL)
# ----------------------------------------------------------
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD="your_database_password"
DATABASE_NAME="bsedrc_examination_db"
DATABASE_URL="mysql://root:password@127.0.0.1:3306/bsedrc_examination_db"

# ----------------------------------------------------------
# 4. APP & SERVER SETTINGS
# ----------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"


