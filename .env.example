SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret
SUPABASE_STORAGE_BUCKET=student-documents
SUPABASE_STORAGE_PUBLIC_BUCKET=student-documents-public
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Set to true when developing without internet/Supabase. The API server and
# health endpoint remain available, but database-backed operations are disabled.
OFFLINE_MODE=false
# Payment gateway configuration. Payment routes remain disabled unless a
# server-side Razorpay verification flow is implemented; OFFLINE_MODE=true
# enables the local simulated payment flow only.
RAZORPAY_KEY_ID=
RAZORPAY_CURRENCY=INR
# Informational legacy database fields used only by /api/system/env-status.
DATABASE_URL=
DATABASE_HOST=
# Future only; do not configure until an R2 provider is implemented.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
